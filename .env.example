# Matrix server name used in Matrix IDs, e.g. @admin:matrix.example.com.
# For a purely local lab, "localhost" is fine. For cloud use, set a real domain.
MATRIX_SERVER_NAME=localhost

# Public base URL used by clients. For local testing, keep this as-is.
MATRIX_PUBLIC_BASEURL=http://localhost:8008/

# Synapse official image requires this during config generation.
SYNAPSE_REPORT_STATS=no

# Change these before exposing anything outside localhost.
POSTGRES_PASSWORD=change-me-postgres
SYNAPSE_REGISTRATION_SHARED_SECRET=change-me-registration-secret

# Container tags. "latest" is convenient for a lab; pin versions before production.
SYNAPSE_TAG=latest
POSTGRES_TAG=16-alpine
ELEMENT_TAG=latest
MAUTRIX_TELEGRAM_TAG=latest
MAUTRIX_DISCORD_TAG=latest
MAUTRIX_SLACK_TAG=latest

# Agent service. Obtain the access token after running: make create-agent AGENT_PASS='...'
# Then login via Matrix API to get the token.
AGENT_ACCESS_TOKEN=

# Auth relay. Bearer secret for /login/* endpoints; admin token used to
# drive bridge bot DMs from the relay process.
ADMIN_ACCESS_TOKEN=
RELAY_SHARED_SECRET=

# Gmail (optional). Create an OAuth 2.0 Desktop App client in Google Cloud
# Console, enable the Gmail API, and paste the client_id/secret here.
# Leave empty to skip Gmail integration entirely.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1:8765/login/gmail/callback
GMAIL_POLL_SECONDS=30
GMAIL_COLD_START_LIMIT=200
GMAIL_COLD_START_QUERY=newer_than:30d
GMAIL_SENDER_POLL_SECONDS=10

# Ticket API. Shared bearer secret for the BFF <-> ticket-api trust boundary.
# Generate with: openssl rand -base64 24 | tr -d /+= | head -c 32
TICKET_API_SHARED_SECRET=
# Ticket widget cookie signing secret (Matrix OpenID -> short-lived cookie).
WIDGET_COOKIE_SECRET=

# Issue Engine (Closed-Loop Engine). Auto-detects customer problems on top of
# tickets and flags un-closed-loop (未闭环) ones.
ISSUE_API_SHARED_SECRET=
# SLA: customer message unanswered this long => flagged. Decision: 2h, 7x24.
ISSUE_SLA_UNANSWERED_SECONDS=7200
# After an explicit customer thanks, auto-confirm closure once this grace passes.
ISSUE_CLOSURE_GRACE_SECONDS=259200
# Comma-separated sender ids/names that are OUR operators (role inference).
ISSUE_AGENT_SENDERS=
# One-shot historical backfill: set ISSUE_BACKFILL=1 for the first run only.
ISSUE_BACKFILL=
ISSUE_BACKFILL_SINCE=
# LLM adjudication (external API only — local self-hosting ruled out).
# none = pure heuristics, ZERO egress (default). api = OpenAI-compatible endpoint
# for the ambiguous residue only (cheap domestic model, e.g. GLM).
ISSUE_LLM_BACKEND=none
ISSUE_LLM_BASE_URL=
ISSUE_LLM_API_KEY=
ISSUE_LLM_MODEL=
# Daily spend ceiling in CNY; 0 = no ceiling. Exhaustion degrades to none.
ISSUE_LLM_DAILY_BUDGET_CNY=0
# Issue dashboard (P2). Comma-separated mxids allowed to use the cross-customer
# dashboard at /dashboard. EMPTY = dashboard disabled (fail-closed).
REVIEWER_ALLOWLIST=

