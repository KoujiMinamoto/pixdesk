# Matrix server name used in Matrix IDs, e.g. @admin:matrix.example.com.
# For a purely local lab, "localhost" is fine. For cloud use, set a real domain.
MATRIX_SERVER_NAME=localhost

# Public base URL used by clients. For local testing, keep this as-is.
MATRIX_PUBLIC_BASEURL=http://localhost:8008/

# Synapse official image requires this during config generation.
SYNAPSE_REPORT_STATS=no

# Change these before exposing anything outside localhost.
POSTGRES_PASSWORD=change-me-postgres
SYNAPSE_REGISTRATION_SHARED_SECRET=change-me-registration-secret

# Container tags. "latest" is convenient for a lab; pin versions before production.
SYNAPSE_TAG=latest
POSTGRES_TAG=16-alpine
ELEMENT_TAG=latest
MAUTRIX_TELEGRAM_TAG=latest
MAUTRIX_DISCORD_TAG=latest
MAUTRIX_SLACK_TAG=latest

# Agent service. Obtain the access token after running: make create-agent AGENT_PASS='...'
# Then login via Matrix API to get the token.
AGENT_ACCESS_TOKEN=

# Auth relay. Bearer secret for /login/* endpoints; admin token used to
# drive bridge bot DMs from the relay process.
ADMIN_ACCESS_TOKEN=
RELAY_SHARED_SECRET=

# Gmail (optional). Create an OAuth 2.0 Desktop App client in Google Cloud
# Console, enable the Gmail API, and paste the client_id/secret here.
# Leave empty to skip Gmail integration entirely.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1:8765/login/gmail/callback
GMAIL_POLL_SECONDS=30
GMAIL_COLD_START_LIMIT=200
GMAIL_COLD_START_QUERY=newer_than:30d
GMAIL_SENDER_POLL_SECONDS=10

