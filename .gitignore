.idea/
.vscode/

# Claude Code local settings (contains prod host credentials) + migration handoff
.claude/
pixdesk-handoff/
pixdesk-handoff.tar.gz

# Node / Electron client builds
node_modules/
dist/
out/

# Generated analysis output. Contains real customer chat text — never commit.
reports/
